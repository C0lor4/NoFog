  (import "horizon" "host" (func $host (param i32 i32 i32 i32 i32) (result i32)))
  (data (global.get $base) "{{payload}}")
  {{accessors}}

  (func (export "horizon_layout") (result i64) i64.const 0xa51c4e0bff942bbe)
  (global $depth (mut i32) (i32.const 0))
  (global $active (mut i32) (i32.const 1))
  (global $water (mut i32) (i32.const 1))
  (global $lava (mut i32) (i32.const 1))
  (global $snow (mut i32) (i32.const 1))
  (global $known (mut i32) (i32.const 0))

  ;; Each of 32 nested calls retains its own allocation for the input/return
  ;; and a small inline host-reply buffer. Keeping input until the next call
  ;; at the same depth also keeps returned pointers alive.
  (func $frame (param $level i32) (result i32)
    (if (i32.ge_u (local.get $level) (i32.const 32)) (then unreachable))
    (i32.add (i32.add (global.get $base) (i32.const 1024))
      (i32.mul (local.get $level) (i32.const 32))))
  (func (export "horizon_in") (param $len i32) (result i32)
    (local $f i32) (local $new i32)
    (local.set $f (call $frame (global.get $depth)))
    (if (i32.gt_u (local.get $len) (i32.load offset=4 (local.get $f)))
      (then
        (local.set $new (call $alloc (local.get $len) (i32.const 8)))
        (if (i32.eqz (local.get $new)) (then unreachable))
        (if (i32.load (local.get $f))
          (then (call $free (i32.load (local.get $f))
                  (i32.load offset=4 (local.get $f)) (i32.const 8))))
        (i32.store (local.get $f) (local.get $new))
        (i32.store offset=4 (local.get $f) (local.get $len))))
    (i32.store offset=8 (local.get $f) (local.get $len))
    (i32.load (local.get $f)))

  (func $pack (param $ptr i32) (param $len i32) (result i64)
    (i64.or (i64.shl (i64.extend_i32_u (local.get $ptr)) (i64.const 32))
      (i64.extend_i32_u (local.get $len))))
  (func $reply (result i32)
    (i32.add (call $frame (i32.sub (global.get $depth) (i32.const 1))) (i32.const 12)))
  (func $request (param $id i32) (param $ptr i32) (param $len i32) (result i32)
    (local $count i32)
    (local.set $count (call $host (local.get $id) (local.get $ptr) (local.get $len)
