    (i32.load8_u (call $reply)))
  (func $setting (param $ptr i32) (param $len i32) (result i32)
    (local $n i32)
    (local.set $n (call $request (i32.const 195) (local.get $ptr) (local.get $len)))
    (if (i32.and (i32.eq (local.get $n) (i32.const 2))
          (i32.eq (i32.load8_u (call $reply)) (i32.const 1)))
      (then (return (i32.load8_u offset=1 (call $reply)))))
    (if (i32.and (i32.eq (local.get $n) (i32.const 1))
          (i32.eqz (i32.load8_u (call $reply)))) (then (return (i32.const 1))))
    unreachable)
  (func $refresh
