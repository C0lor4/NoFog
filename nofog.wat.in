    (if (i32.eq (local.get $id) (i32.const 360))
      (then (if (i32.eqz (global.get $known)) (then call $refresh)) (return (i64.const 0))))
    (if (i32.eq (local.get $id) (i32.const 90))
      (then
        (if (i32.lt_u (local.get $len) (i32.const 17)) (then unreachable))
        ;; The final fields are raw_code (u32), action (u32) and modifiers (u32).
        (local.set $ptr (i32.sub (i32.add (local.get $ptr) (local.get $len)) (i32.const 12)))
        (call $input (i32.eq (i32.load offset=4 (local.get $ptr)) (i32.const 1)))
        (return (call $pack (local.get $ptr) (i32.const 12)))))
    (if (i32.eq (local.get $id) (i32.const 81))
      (then
        (if (i32.ne (local.get $len) (i32.const 9)) (then unreachable))
        (call $input (i32.load8_u offset=4 (local.get $ptr)))
        (return (call $pack (local.get $ptr) (local.get $len)))))
    (if (i32.eq (local.get $id) (i32.const 330))
      (then
