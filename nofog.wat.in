            (i32.and (i32.eq (local.get $type) (i32.const 3)) (global.get $snow)))))
        (if (i32.and (global.get $active) (local.get $clear))
          (then (if (call $is_enabled) (then (i32.store offset=24 (local.get $ptr) (i32.const 0))))))
        (return (call $pack (local.get $ptr) (local.get $len)))))
    unreachable)
  (func (export "horizon_hook") (param $id i32) (result i64)
    (local $f i32) (local $result i64)
