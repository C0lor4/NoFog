;; shares linear memory with the runtime; pointers must be relative to $base
;; or supplied by the runtime allocator. The dynamic linker reserves 2048
;; bytes (alignment 16) for static data and the frame descriptors.
(module
  (@custom "dylink.0" "\01\05\80\10\04\00\00")
  (import "env" "memory" (memory 0))
  (import "env" "__memory_base" (global $base i32))
  (import "env" "_RNvCs5fGHjzWXRav_7___rustc12___rust_alloc"
    (func $alloc (param i32 i32) (result i32)))
  (import "env" "_RNvCs5fGHjzWXRav_7___rustc14___rust_dealloc"
