    (if (i32.or (i32.ne (local.get $n) (i32.const 1))
          (i32.ne (i32.load8_u (call $reply)) (i32.const 0))) (then unreachable)))
  (func $register
    i32.const 1218 call $register_key call $request drop
    call $register_active call $declare
    call $register_water call $declare
    call $register_lava call $declare
    call $register_powder_snow call $declare)

  ;; Horizon has updated the mod's key mapping before input_key and
  ;; mouse_button_post. Consume this event's click, including OS repeats,
  ;; but toggle only on a real press, so rebinding works for keys and mice.
  (func $input (param $press i32)
    i32.const 144 call $binding call $boolean
    local.get $press i32.and
    if
      (if (i32.and (call $is_enabled) (call $boolean (i32.const 145) (i32.const 0) (i32.const 0)))
        (then
          i32.const 17
          call $active call $setting
          if (result i32 i32) call $off else call $on end
